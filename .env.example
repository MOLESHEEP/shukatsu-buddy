# ---------- Required ----------
# Long random string used to sign login sessions. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Postgres password (used by docker-compose for both the db and the app)
POSTGRES_PASSWORD=change-me-db-password

# ---------- LLM ----------
# auto  = use Anthropic if ANTHROPIC_API_KEY is set, else OpenAI-compatible if OPENAI_API_KEY is set, else demo mode
# anthropic | openai | mock
LLM_PROVIDER=auto

# Claude (recommended)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Any OpenAI-compatible endpoint (DeepSeek, Qwen/DashScope, Moonshot, Ollama, vLLM ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- App ----------
# Host port the app is published on
APP_PORT=3000
# Public URL of your site (used for calendar subscription links)
PUBLIC_URL=http://localhost:3000
# Timezone used to interpret dates in Japanese emails
APP_TIMEZONE=Asia/Tokyo
# Free-plan limits from the PRD. Set ENFORCE_QUOTA=true to turn them on.
ENFORCE_QUOTA=false
FREE_ES_LIMIT=3
FREE_EMAIL_LIMIT=5

# ---------- Optional HTTPS (docker compose --profile https up -d) ----------
DOMAIN=shukatsu.example.com
