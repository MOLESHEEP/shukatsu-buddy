# ---------- Required ----------
# Long random string used to sign login sessions. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Postgres password (used by docker-compose for both the db and the app)
POSTGRES_PASSWORD=change-me-db-password

# ---------- 管理员 ----------
# 这些邮箱的账号是管理员（逗号分隔）。若账号还不存在，启动时用 ADMIN_PASSWORD 自动创建。
# 已存在的账号不会被改密码；登录后请在「设置」里修改密码。
ADMIN_EMAILS=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# 新用户默认能否使用 AI（管理后台可随时修改；默认 false = 由管理员逐个开通）
# AI_DEFAULT_ENABLED=false

# ---------- LLM ----------
# 填任意一家（或几家）的 API Key 即可。没有任何 Key 时自动进入演示模式。
#
# LLM_PROVIDER：主力 AI。auto = 按下面的顺序用第一个配置好的。
#   auto | anthropic | openai | deepseek | kimi | qwen | glm | gemini | doubao | ollama | custom | mock
LLM_PROVIDER=auto
# LLM_FALLBACK：主力出错（超时 / 5xx / 限流）时依次尝试的备用，逗号分隔，例：deepseek,kimi
LLM_FALLBACK=
#
# 每家都可以用 <ID>_MODEL 换模型、<ID>_BASE_URL 换地址（代理 / 其他地域）。
# 不确定模型名？部署后到「设置 → AI 引擎」点列表按钮，查看这个 Key 能用的所有模型。

# Claude (Anthropic)          默认模型 claude-opus-5-5
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ChatGPT (OpenAI)            默认模型 gpt-6.1-sol
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol

# DeepSeek                    默认模型 deepseek-flash（也可用 deepseek-v4-pro）
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Kimi (Moonshot)             默认模型 kimi-k3；国内账号的 Key 需改 KIMI_BASE_URL
KIMI_API_KEY=
# KIMI_MODEL=kimi-k3
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# 通义千问 Qwen (阿里云百炼)   默认模型 qwen-plus；非北京地域请改 QWEN_BASE_URL
QWEN_API_KEY=
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 智谱 GLM                    默认模型 glm-5.3
GLM_API_KEY=
# GLM_MODEL=glm-5.3

# Gemini (Google)             默认模型 gemini-3.8-flash
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# 豆包 Doubao (火山方舟)       必须填写模型 ID 或推理接入点 ID（ep-…）
DOUBAO_API_KEY=
# DOUBAO_MODEL=

# Ollama 本地模型（无需 Key，填模型名即启用；容器内访问宿主机用 host.docker.internal）
# OLLAMA_MODEL=qwen3:14b
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# 自定义 OpenAI 兼容服务（OpenRouter、SiliconFlow、vLLM、LM Studio …）
# CUSTOM_BASE_URL=https://openrouter.ai/api/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=
# CUSTOM_JSON_MODE=json_object   # json_schema | json_object | none

# ---------- App ----------
# Host port the app is published on
APP_PORT=3000
# Public URL of your site (used for calendar subscription links)
PUBLIC_URL=http://localhost:3000
# Timezone used to interpret dates in Japanese emails
APP_TIMEZONE=Asia/Tokyo
# 每人每天的 AI 次数（ES 10 / 邮件助手 10 / 经验整理 10）在「管理后台 → AI 与额度」中设置

# ---------- Optional HTTPS (docker compose --profile https up -d) ----------
DOMAIN=shukatsu.example.com
